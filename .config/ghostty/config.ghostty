font-family = "Monego Nerd Font Mono"
font-size = 13
font-thicken = true
adjust-cell-width = -8%

quit-after-last-window-closed = true
confirm-close-surface = false

window-decoration = none
cursor-style-blink = false
adjust-cursor-thickness = 2

background = #fdf6e3
foreground = #657b83
cursor-color = #586e75

selection-background = #475b62
selection-foreground = #eae3cb

