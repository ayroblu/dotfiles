palette = 9=#cb4b16

palette = 2=#859900
palette = 10=#586e75

palette = 3=#b58900
palette = 11=#657b83

palette = 4=#268bd2
palette = 12=#839496

palette = 5=#d33682
palette = 13=#6c71c4

